diff --git a/lib/libzpool/abd_os.c b/lib/libzpool/abd_os.c
index 8bd7a64ab..8ba74371c 100644
--- a/lib/libzpool/abd_os.c
+++ b/lib/libzpool/abd_os.c
@@ -107,15 +107,30 @@ abd_alloc_chunks(abd_t *abd, size_t size)
 	uint_t n = ABD_SCATTER(abd).abd_iovcnt;
 	ASSERT3U(n, ==, abd_iovcnt_for_bytes(size));
 
+	struct iovec *iov = ABD_SCATTER(abd).abd_iov;
+#ifdef _WIN32
+	/*
+	 * One region for all the iovecs.  _aligned_malloc(4096, 4096) takes
+	 * 8 KiB of heap, so a page each doubled the ARC's real footprint in
+	 * zfswin-um.exe (GitHub issue #3).  64-byte alignment is what the
+	 * SIMD checksum and RAID-Z code needs of a mapped chunk.
+	 */
+	char *base = umem_alloc_aligned((size_t)n * ABD_PAGESIZE, 64,
+	    UMEM_NOFAIL);
+	for (int i = 0; i < n; i++) {
+		iov[i].iov_base = base + (size_t)i * ABD_PAGESIZE;
+		iov[i].iov_len = ABD_PAGESIZE;
+	}
+#else
 	/*
 	 * Allocate a ABD_PAGESIZE region for each iovec.
 	 */
-	struct iovec *iov = ABD_SCATTER(abd).abd_iov;
 	for (int i = 0; i < n; i++) {
 		iov[i].iov_base =
 		    umem_alloc_aligned(ABD_PAGESIZE, ABD_PAGESIZE, UMEM_NOFAIL);
 		iov[i].iov_len = ABD_PAGESIZE;
 	}
+#endif
 }
 
 void
@@ -123,8 +138,12 @@ abd_free_chunks(abd_t *abd)
 {
 	uint_t n = ABD_SCATTER(abd).abd_iovcnt;
 	struct iovec *iov = ABD_SCATTER(abd).abd_iov;
+#ifdef _WIN32
+	umem_free_aligned(iov[0].iov_base, (size_t)n * ABD_PAGESIZE);
+#else
 	for (int i = 0; i < n; i++)
 		umem_free_aligned(iov[i].iov_base, ABD_PAGESIZE);
+#endif
 }
 
 boolean_t
