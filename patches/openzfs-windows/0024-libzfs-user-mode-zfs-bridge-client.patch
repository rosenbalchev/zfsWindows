index 000000000..c991e32bb
--- /dev/null
+++ b/lib/libspl/include/os/windows/sys/zfs_bridge.h
@@ -0,0 +1,79 @@
+/*
+ * CDDL HEADER START
+ *
+ * The contents of this file are subject to the terms of the
