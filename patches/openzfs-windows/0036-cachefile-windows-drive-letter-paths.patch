+/*
+ * The last directory separator of an absolute cache file path, or NULL if
+ * the path is not absolute.  On Windows, "C:\dir\file" and "C:/dir/file"
+ * are absolute too, with either separator.
+ */
+static char *
+cachefile_last_slash(const char *path)
+{
+#ifdef _WIN32
+	if (((path[0] | 0x20) >= 'a' && (path[0] | 0x20) <= 'z') &&
+	    path[1] == ':' && (path[2] == '\\' || path[2] == '/')) {
+		const char *slash = strrchr(path, '/');
+		const char *back = strrchr(path, '\\');
+
+		if (back != NULL && (slash == NULL || back > slash))
+			slash = back;
+		return ((char *)slash);
+	}
+#endif
+	return (path[0] == '/' ? strrchr(path, '/') : NULL);
+}
