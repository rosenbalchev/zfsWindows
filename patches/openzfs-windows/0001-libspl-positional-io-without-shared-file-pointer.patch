+/*
+ * Positional I/O must not go through the shared file pointer: libzpool
+ * issues concurrent vdev_file reads and writes from taskq threads, and a
+ * seek/ReadFile/WriteFile sequence lets another thread move the pointer in
+ * between, landing data at the wrong offset.  On a synchronous handle an
+ * OVERLAPPED offset makes the position part of the single I/O request.
+ */
+static void
+overlapped_at(OVERLAPPED *ov, off_t offset)
+{
+	memset(ov, 0, sizeof (*ov));
+	ov->Offset = (DWORD)((uint64_t)offset & 0xffffffffULL);
+	ov->OffsetHigh = (DWORD)((uint64_t)offset >> 32);
+}
