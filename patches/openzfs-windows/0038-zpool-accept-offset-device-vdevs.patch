--- a/cmd/zpool/zpool_vdev.c
+++ b/cmd/zpool/zpool_vdev.c
@@ -192,6 +192,37 @@ is_shorthand_path(const char *arg, char *path, size_t path_size,
 	return (error);
 }
 
+#ifdef _WIN32
+/*
+ * A whole-disk vdev is stored as "#offset#length#device".  The zpool
+ * command validates a new vdev before libzpool opens it, so validate the
+ * underlying device while retaining the encoded path in the nvlist.
+ */
+static const char *
+zpool_offset_device_path(const char *arg, char *base, size_t base_size)
+{
+	const char *p;
+	char *end;
+
+	if (arg[0] != '#')
+		return (arg);
+
+	errno = 0;
+	(void) strtoull(arg + 1, &end, 10);
+	if (errno == ERANGE || end == arg + 1 || *end != '#')
+		return (arg);
+	p = end + 1;
+	errno = 0;
+	(void) strtoull(p, &end, 10);
+	if (errno == ERANGE || end == p || *end != '#' || end[1] == '\0' ||
+	    strlen(end + 1) >= base_size)
+		return (arg);
+
+	strlcpy(base, end + 1, base_size);
+	return (base);
+}
+#endif
+
