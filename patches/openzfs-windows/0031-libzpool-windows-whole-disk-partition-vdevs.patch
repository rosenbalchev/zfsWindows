diff --git a/include/sys/zfs_file.h b/include/sys/zfs_file.h
index ca96114bd..51266f91d 100644
--- a/include/sys/zfs_file.h
+++ b/include/sys/zfs_file.h
@@ -31,6 +31,8 @@ typedef struct zfs_file {
 	int f_fd;
 	int f_dump_fd;
 #ifdef _WIN32
+	/* "#offset#length#device": partition length, 0 for a file or device */
+	loff_t f_win_length;
 	loff_t f_win_offset;
 #endif
 } zfs_file_t;
diff --git a/lib/libzpool/zfs_file_os.c b/lib/libzpool/zfs_file_os.c
index cd6df2378..b95039adb 100644
--- a/lib/libzpool/zfs_file_os.c
+++ b/lib/libzpool/zfs_file_os.c
@@ -85,6 +85,25 @@ zfs_file_open(const char *path, int flags, int mode, cred_t *cr,
 	fp->f_dump_fd = dump_fd;
 	*fpp = fp;
 
+#ifdef _WIN32
+	/*
+	 * "#offset#length#device" is the ZFS partition zpool made on a whole
+	 * disk (zpool_vdev_os.c).  wosix_open() opened the device; I/O is
+	 * relative to the partition, and the vdev ends where the partition
+	 * does, not at the end of the disk, which holds the backup GPT.
+	 */
+	fp->f_win_offset = 0;
+	fp->f_win_length = 0;
+	if (path[0] == '#') {
+		char *end = NULL;
+
+		fp->f_win_offset = strtoull(&path[1], &end, 10);
+		while (end != NULL && *end == '#')
+			end++;
+		fp->f_win_length = strtoull(end, NULL, 10);
+	}
+#endif
+
 	return (0);
 }
 
@@ -150,6 +169,9 @@ zfs_file_pwrite(zfs_file_t *fp, const void *buf,
 	zfs_file_observer_t observer = zfs_file_observer;
 	int error;
 
+#ifdef _WIN32
+	pos += fp->f_win_offset;
+#endif
 	if (observer != NULL)
 		observer(ZFS_FILE_WRITE_BEGIN, fp, buf, count, pos, 0);
 	error = zfs_file_pwrite_impl(fp, buf, count, pos, ashift, resid);
@@ -249,6 +271,10 @@ zfs_file_pread(zfs_file_t *fp, void *buf, size_t count, loff_t off,
 {
 	ssize_t rc;
 
+#ifdef _WIN32
+	off += fp->f_win_offset;
+#endif
+
 	rc = pread64(fp->f_fd, buf, count, off);
 	if (rc < 0) {
 #ifdef __linux__
@@ -322,6 +348,11 @@ zfs_file_getattr(zfs_file_t *fp, zfs_file_attr_t *zfattr)
 
 	zfattr->zfa_size = st.st_size;
 	zfattr->zfa_mode = st.st_mode;
+#ifdef _WIN32
+	/* A partition of a disk: its length, not the disk's. */
+	if (fp->f_win_length > 0)
+		zfattr->zfa_size = fp->f_win_length;
+#endif
 
 	return (0);
 }
