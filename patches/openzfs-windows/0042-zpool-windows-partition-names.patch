+/*
+ * An extent "#offset#length#device" is written through the disk, past any
+ * volume Windows has on it.  It is in use when it overlaps a volume that
+ * has a mount point (a drive letter or folder), a file system other than
+ * RAW, or a handle that keeps it from being locked.  Windows gives an
+ * unformatted basic partition a RAW volume; that one is free to use.
+ */
+static int
+check_extent(const char *path, int force)
+{
+	unsigned long long offset, length;
+	STORAGE_DEVICE_NUMBER sdn;
+	char volume[MAX_PATH], device[MAX_PATH], names[MAX_PATH];
+	char fs[MAX_PATH];
+	BYTE buffer[sizeof (VOLUME_DISK_EXTENTS) + 15 * sizeof (DISK_EXTENT)];
+	VOLUME_DISK_EXTENTS *extents = (VOLUME_DISK_EXTENTS *)buffer;
+	const char *dev;
+	char *end;
+	HANDLE h, find;
+	DWORD bytes;
+	int err = 0;
+
+	offset = strtoull(path + 1, &end, 10);
+	if (*end != '#')
+		return (0);
+	length = strtoull(end + 1, &end, 10);
+	if (*end != '#')
+		return (0);
+	dev = end + 1;
+
+	h = CreateFileA(dev, 0, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+	    OPEN_EXISTING, 0, NULL);
+	if (h == INVALID_HANDLE_VALUE)
+		return (0);
+	if (!DeviceIoControl(h, IOCTL_STORAGE_GET_DEVICE_NUMBER, NULL, 0,
+	    &sdn, sizeof (sdn), &bytes, NULL)) {
+		CloseHandle(h);
+		return (0);
+	}
+	CloseHandle(h);
+
+	find = FindFirstVolumeA(volume, sizeof (volume));
+	if (find == INVALID_HANDLE_VALUE)
+		return (0);
+	do {
+		const char *why = NULL;
+		boolean_t overlaps = B_FALSE;
+		size_t n = strlen(volume);
+
+		/* "\\?\Volume{guid}\": the volume device has no slash. */
+		if (n == 0 || n >= sizeof (device))
+			continue;
+		strlcpy(device, volume, sizeof (device));
+		device[n - 1] = '\0';
+
+		h = CreateFileA(device, 0, FILE_SHARE_READ | FILE_SHARE_WRITE,
+		    NULL, OPEN_EXISTING, 0, NULL);
+		if (h == INVALID_HANDLE_VALUE)
+			continue;
+		if (DeviceIoControl(h, IOCTL_VOLUME_GET_VOLUME_DISK_EXTENTS,
+		    NULL, 0, extents, sizeof (buffer), &bytes, NULL)) {
+			for (DWORD i = 0; i < extents->NumberOfDiskExtents; i++) {
+				DISK_EXTENT *e = &extents->Extents[i];
+				unsigned long long start =
+				    e->StartingOffset.QuadPart;
+
+				if (e->DiskNumber == sdn.DeviceNumber &&
+				    start < offset + length &&
+				    offset < start + e->ExtentLength.QuadPart)
+					overlaps = B_TRUE;
+			}
+		}
+		CloseHandle(h);
+		if (!overlaps)
+			continue;
+
+		names[0] = '\0';
+		fs[0] = '\0';
+		if (GetVolumePathNamesForVolumeNameA(volume, names,
+		    sizeof (names), &bytes) && names[0] != '\0') {
+			why = "is mounted at";
+		} else if (GetVolumeInformationA(volume, NULL, 0, NULL, NULL,
+		    NULL, fs, sizeof (fs)) && fs[0] != '\0' &&
+		    strcasecmp(fs, "RAW") != 0) {
+			why = "holds a file system:";
+			strlcpy(names, fs, sizeof (names));
+		} else {
+			h = CreateFileA(device, GENERIC_READ,
+			    FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+			    OPEN_EXISTING, 0, NULL);
+			if (h == INVALID_HANDLE_VALUE ||
+			    !DeviceIoControl(h, FSCTL_LOCK_VOLUME, NULL, 0,
+			    NULL, 0, &bytes, NULL))
+				why = "is open";
+			else
+				(void) DeviceIoControl(h, FSCTL_UNLOCK_VOLUME,
+				    NULL, 0, NULL, 0, &bytes, NULL);
+			if (h != INVALID_HANDLE_VALUE)
+				CloseHandle(h);
+		}
+		if (why != NULL) {
+			(void) fprintf(stderr, gettext("%s overlaps volume %s, "
+			    "which %s %s\n"), path, volume, why, names);
+			err = force ? 0 : EBUSY;
+		}
+	} while (FindNextVolumeA(find, volume, sizeof (volume)));
+	FindVolumeClose(find);
+
+	return (err);
+}
