+
+/*
+ * A partition named as Windows names it -- HarddiskNPartitionM,
+ * HarddiskN\PartitionM, PhysicalDriveN\PartitionM or PhysicalDiskN\PartitionM,
+ * with "/" or "\" and with or without \?\, \.\ or /dev/ in front --
+ * becomes the extent it covers on its disk, "#offset#length#\?\PhysicalDriveN".
+ * That is the form zpool gives the ZFS partition of a whole disk: the
+ * driver and the user-mode engine both open it, and the driver records
+ * the disk by its identity, not its number, which can change.
+ * Partition 0 is Windows' name for the whole disk; it is refused, so that
+ * a whole disk is only ever named as one.
+ *
+ * Returns 0 when arg names no partition, 1 with the extent in path, and
+ * -1 after printing why the partition cannot be used.
+ */
+int
+zpool_partition_device_path(const char *arg, char *path, size_t size)
+{
+	static const char *prefixes[] =
+	    { "\\?\\", "\\.\\", "//?/", "//./", "/dev/" };
+	static const char *disks[] =
+	    { "Harddisk", "PhysicalDrive", "PhysicalDisk" };
+	DRIVE_LAYOUT_INFORMATION_EX *layout = NULL;
+	DWORD layout_size = sizeof (DRIVE_LAYOUT_INFORMATION_EX) +
+	    127 * sizeof (PARTITION_INFORMATION_EX);
+	const char *p = arg;
+	char drive[64];
+	unsigned long disk, part;
+	char *end;
+	boolean_t named = B_FALSE;
+	HANDLE h;
+	DWORD bytes;
+	int ret = -1;
+
+	for (size_t i = 0; i < sizeof (prefixes) / sizeof (prefixes[0]); i++) {
+		if (strncasecmp(p, prefixes[i], strlen(prefixes[i])) == 0) {
+			p += strlen(prefixes[i]);
+			break;
+		}
+	}
+	for (size_t i = 0; i < sizeof (disks) / sizeof (disks[0]) && !named; i++) {
+		if (strncasecmp(p, disks[i], strlen(disks[i])) == 0) {
+			p += strlen(disks[i]);
+			named = B_TRUE;
+		}
+	}
+	if (!named || !isdigit(*p))
+		return (0);
+	disk = strtoul(p, &end, 10);
+	p = end;
+	if (*p == '\' || *p == '/')
+		p++;
+	if (strncasecmp(p, "Partition", 9) != 0 || !isdigit(p[9]))
+		return (0);
+	part = strtoul(p + 9, &end, 10);
+	if (*end != '\0')
+		return (0);
+
+	if (part == 0) {
+		(void) fprintf(stderr, gettext("cannot use '%s': partition 0 "
+		    "is the whole disk; name the whole disk as "
+		    "\\?\PhysicalDrive%lu\n"), arg, disk);
+		return (-1);
+	}
+	if (disk > 9999) {
+		(void) fprintf(stderr, gettext("cannot use '%s': no such "
+		    "disk\n"), arg);
+		return (-1);
+	}
+
+	(void) snprintf(drive, sizeof (drive), "\\.\PhysicalDrive%lu",
+	    disk);
+	h = CreateFileA(drive, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
+	    NULL, OPEN_EXISTING, 0, NULL);
+	if (h == INVALID_HANDLE_VALUE) {
+		(void) fprintf(stderr, gettext("cannot use '%s': cannot open "
+		    "disk %lu (error %lu)\n"), arg, disk, GetLastError());
+		return (-1);
+	}
+	for (int tries = 0; tries < 4; tries++) {
+		layout = malloc(layout_size);
+		if (layout == NULL)
+			break;
+		if (DeviceIoControl(h, IOCTL_DISK_GET_DRIVE_LAYOUT_EX, NULL, 0,
+		    layout, layout_size, &bytes, NULL))
+			break;
+		free(layout);
+		layout = NULL;
+		if (GetLastError() != ERROR_INSUFFICIENT_BUFFER)
+			break;
+		layout_size *= 2;
+	}
+	CloseHandle(h);
+	if (layout == NULL) {
+		(void) fprintf(stderr, gettext("cannot use '%s': cannot read "
+		    "the partition table of disk %lu\n"), arg, disk);
+		return (-1);
+	}
+
+	for (DWORD i = 0; i < layout->PartitionCount; i++) {
+		PARTITION_INFORMATION_EX *pi = &layout->PartitionEntry[i];
+
+		if (pi->PartitionNumber != part ||
+		    pi->PartitionLength.QuadPart <= 0)
+			continue;
+		/* An MBR extended partition only holds logical ones. */
+		if (pi->PartitionStyle == PARTITION_STYLE_MBR &&
+		    IsContainerPartition(pi->Mbr.PartitionType))
+			continue;
+		(void) snprintf(path, size, "#%llu#%llu#\\?\PhysicalDrive%lu",
+		    (unsigned long long)pi->StartingOffset.QuadPart,
+		    (unsigned long long)pi->PartitionLength.QuadPart, disk);
+		ret = 1;
+		break;
+	}
+	if (ret != 1)
+		(void) fprintf(stderr, gettext("cannot use '%s': disk %lu has "
+		    "no partition %lu\n"), arg, disk, part);
+	free(layout);
+	return (ret);
+}
