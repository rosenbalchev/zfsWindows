diff --git a/lib/libzpool/zfs_file_os.c b/lib/libzpool/zfs_file_os.c
--- a/lib/libzpool/zfs_file_os.c
+++ b/lib/libzpool/zfs_file_os.c
@@ -33,6 +33,23 @@ char *vn_dumpdir = NULL;
  *
  * Returns 0 on success underlying error on failure.
  */
+#ifdef _WIN32
+/* Return the physical-device path from "#offset#length#device". */
+static const char *
+zfs_file_windows_path(const char *path)
+{
+	const char *hash;
+
+	if (path[0] != '#')
+		return (path);
+	hash = strchr(path + 1, '#');
+	if (hash == NULL)
+		return (path);
+	hash = strchr(hash + 1, '#');
+	return (hash != NULL && hash[1] != '\0' ? hash + 1 : path);
+}
+#endif
+
 int
 zfs_file_open(const char *path, int flags, int mode, cred_t *cr,
     zfs_file_t **fpp)
@@ -44,8 +61,13 @@ zfs_file_open(const char *path, int flags, int mode, cred_t *cr,
 	int old_umask = 0;
 	zfs_file_t *fp;
 	struct stat64 st;
+#ifdef _WIN32
+	const char *open_path = zfs_file_windows_path(path);
+#else
+	const char *open_path = path;
+#endif
 
-	if (!(flags & O_CREAT) && stat64(path, &st) == -1)
+	if (!(flags & O_CREAT) && stat64(open_path, &st) == -1)
 		return (errno);
 
 	if (!(flags & O_CREAT) && S_ISBLK(st.st_mode))
@@ -54,6 +76,6 @@ zfs_file_open(const char *path, int flags, int mode, cred_t *cr,
 	if (flags & O_CREAT)
 		old_umask = umask(0);
 
-	fd = open64(path, flags, mode);
+	fd = open64(open_path, flags, mode);
 	if (fd == -1)
 		return (errno);
