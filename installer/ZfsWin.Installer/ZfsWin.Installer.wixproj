<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- Built by scripts/build-installer.ps1, which passes the staged payload
       directory, the platform and the test-signing thumbprint. -->
  <Import Project="..\..\build\ZfsWinVersion.props" />
  <PropertyGroup>
    <OutputName>OpenZFS-for-Windows-$(ZfsWinVersion)-$(Platform)</OutputName>
    <Payload Condition="'$(Payload)' == ''">..\..\out\installer-payload\$(Platform)</Payload>
    <!-- The native build packaged (build-installer.ps1 -Configuration).
         Debug installs the PDBs; Release leaves them out.  Both compress
         with mszip: several times faster than high, about 20% larger. -->
    <PackageConfiguration Condition="'$(PackageConfiguration)' == ''">Debug</PackageConfiguration>
    <Symbols Condition="'$(PackageConfiguration)' == 'Debug'">yes</Symbols>
    <Symbols Condition="'$(PackageConfiguration)' != 'Debug'">no</Symbols>
    <Compression Condition="'$(Compression)' == ''">mszip</Compression>
    <DefineConstants>Version=$(ZfsWinVersion);Payload=$(Payload);TestSigningThumbprint=$(TestSigningThumbprint);Symbols=$(Symbols);Compression=$(Compression)</DefineConstants>
    <!-- ICE03: the upstream tools' version resources use LANGID 0x4009, which
         ICE03 does not accept; step 17 stamps real version resources.
         ICE38/ICE43/ICE57: they treat the Start-menu shortcuts of this
         per-machine package as per-user data and demand an HKCU key path;
         with ALLUSERS=1 the shortcuts go to the common Start menu. -->
    <SuppressIces>ICE03;ICE38;ICE43;ICE57</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
