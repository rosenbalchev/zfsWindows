<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- The user-mode (WinFsp) package; built by scripts/build-installer.ps1
       -Variant usermode, which passes the staged payload and the platform. -->
  <Import Project="..\..\build\ZfsWinVersion.props" />
  <PropertyGroup>
    <OutputName>OpenZFS-for-Windows-$(ZfsWinVersion)-$(Platform)-usermode</OutputName>
    <Payload Condition="'$(Payload)' == ''">..\..\out\installer-payload\usermode-$(Platform)</Payload>
    <DefineConstants>Version=$(ZfsWinVersion);Payload=$(Payload)</DefineConstants>
    <!-- ICE38/ICE43/ICE57 treat the Start-menu shortcuts of this per-machine
         package as per-user data; with ALLUSERS=1 they go to the common Start menu. -->
    <SuppressIces>ICE38;ICE43;ICE57</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
