<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- The user-mode (WinFsp) package; built by scripts/build-installer.ps1
       -Variant usermode, which passes the staged payload and the platform. -->
  <Import Project="..\..\build\ZfsWinVersion.props" />
  <PropertyGroup>
    <OutputName>OpenZFS-for-Windows-$(ZfsWinVersion)-$(Platform)-usermode</OutputName>
    <Payload Condition="'$(Payload)' == ''">..\..\out\installer-payload\usermode-$(Platform)</Payload>
    <!-- As in the kernel package: Debug installs the PDBs, Release has
         none; both compress with mszip. -->
    <PackageConfiguration Condition="'$(PackageConfiguration)' == ''">Debug</PackageConfiguration>
    <Symbols Condition="'$(PackageConfiguration)' == 'Debug'">yes</Symbols>
    <Symbols Condition="'$(PackageConfiguration)' != 'Debug'">no</Symbols>
    <Compression Condition="'$(Compression)' == ''">mszip</Compression>
    <DefineConstants>Version=$(ZfsWinVersion);Payload=$(Payload);Symbols=$(Symbols);Compression=$(Compression)</DefineConstants>
    <!-- ICE03: the upstream zpool/zfs version resources use LANGID 0x4009,
         which ICE03 does not accept (as in the kernel package).
         ICE38/ICE43/ICE57 treat the Start-menu shortcuts of this per-machine
         package as per-user data; with ALLUSERS=1 they go to the common Start menu.
         ICE69: the shortcuts' targets are in other components, all in the one
         feature, Main: they never point at a file that is not installed. -->
    <SuppressIces>ICE03;ICE38;ICE43;ICE57;ICE69</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
