<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenZFS for Windows, user-mode variant (plan step 15).

  Installs zfswin-um.exe, which serves ZFS datasets as Windows volumes
  through WinFsp, as the ZfsWinUserMode service.  No kernel driver of ours
  is installed, so nothing here needs a Microsoft signature; WinFsp's own
  driver is Microsoft-signed.  Requires WinFsp (WinFsp - Windows File System
  Proxy, Copyright (C) Bill Zissimopoulos, https://github.com/winfsp/winfsp).

  Administration (plan step 18): the same ZfsWinBroker service, zfswin.exe,
  ZfsWinGui, ZfsWin PowerShell module and upstream zpool.exe/zfs.exe as the
  kernel edition.  Without the driver, zpool/zfs reach zfswin-um's engine
  through the ZFS bridge pipe (SYSTEM and Administrators only).

  Pools created or imported with zpool are recorded under
  HKLM\SOFTWARE\OpenZFS for Windows\UserMode\Pools, and mounts under
  ...\UserMode\Mounts\<name> (Source, Pool, Dataset, MountPoint, ReadOnly),
  so both come back at boot.  Stopping the service, and so uninstalling,
  unmounts and exports every pool; pool data is never touched.  Cannot be
  installed next to the kernel-driver package.

  Public properties (all optional):
    INSTALLFOLDER   default [ProgramFiles64Folder]OpenZFS for Windows (user mode)
    ADDTOPATH=0     do not add the tools to the system PATH
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="OpenZFS for Windows (user mode)"
           Manufacturer="zfsWindows contributors"
           Version="$(var.Version)"
           UpgradeCode="3C1F7A52-9E4B-4D6A-8B2E-6F0D1C5A9E47"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">
    <SummaryInformation Description="OpenZFS for Windows $(var.Version), user mode: ZFS datasets as Windows volumes through WinFsp" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of OpenZFS for Windows (user mode) is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/winfsp/winfsp" />
    <Property Id="ARPCOMMENTS" Value="OpenZFS in user mode, through WinFsp - Windows File System Proxy, Copyright (C) Bill Zissimopoulos" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ADDTOPATH" Value="1" />

    <!-- WinFsp records its install folder in the 32-bit registry view. -->
    <Property Id="WINFSPINSTALLDIR">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\WinFsp" Name="InstallDir" Type="raw" Bitness="always32" />
    </Property>
    <!-- The kernel-driver package; the two variants never share a machine. -->
    <Property Id="KERNELVARIANTFOLDER">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\OpenZFS for Windows" Name="InstallFolder" Type="raw" Bitness="always64" />
    </Property>

    <Launch Condition="Installed OR VersionNT64" Message="OpenZFS for Windows requires 64-bit Windows 10 version 1903 or later." />
    <Launch Condition="Privileged" Message="Installing OpenZFS for Windows requires administrator rights." />
    <Launch Condition="Installed OR WINFSPINSTALLDIR"
            Message="REFUSED: WinFsp is not installed. Install WinFsp 2.1 or later from https://github.com/winfsp/winfsp (WinFsp - Windows File System Proxy, Copyright (C) Bill Zissimopoulos), then run this setup again." />
    <Launch Condition="Installed OR NOT KERNELVARIANTFOLDER"
            Message="REFUSED: OpenZFS for Windows (kernel driver) is installed. Uninstall it first; the two variants cannot be installed together." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="OpenZFS for Windows (user mode)">
        <Directory Id="BINFOLDER" Name="bin" />
        <Directory Id="LICENSEFOLDER" Name="licenses" />
        <Directory Id="SYMBOLSFOLDER" Name="symbols" />
      </Directory>
      <Directory Id="PSFOLDER" Name="WindowsPowerShell">
        <Directory Id="PSMODULES" Name="Modules">
          <Directory Id="PSZFSWIN" Name="ZfsWin">
            <Directory Id="PSMODULEFOLDER" Name="$(var.Version)" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="Service" Directory="BINFOLDER">
      <Component Id="ZfsWinUserMode">
        <File Id="zfswin_um.exe" Source="$(var.Payload)\bin\zfswin-um.exe" KeyPath="yes" />
        <ServiceInstall Id="ZfsWinUserModeService" Name="ZfsWinUserMode" DisplayName="OpenZFS user-mode file system"
                        Description="Mounts ZFS datasets as Windows volumes through WinFsp, as configured under HKLM\SOFTWARE\OpenZFS for Windows\UserMode\Mounts."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
          <ServiceDependency Id="WinFsp.Launcher" />
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                              ThirdFailureActionType="none" RestartServiceDelayInSeconds="10" ResetPeriodInDays="1" />
        </ServiceInstall>
        <!-- Started at install: zpool and zfs need its engine.  Stopping
             exports every pool, so uninstall leaves them importable
             elsewhere. -->
        <ServiceControl Id="ZfsWinUserModeControl" Name="ZfsWinUserMode" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="ZfsWinBroker">
        <File Id="ZfsWinBroker.exe" Source="$(var.Payload)\bin\ZfsWinBroker.exe" KeyPath="yes" />
        <ServiceInstall Id="ZfsWinBrokerService" Name="ZfsWinBroker" DisplayName="OpenZFS broker"
                        Description="Runs ZFS administration commands for zfswin.exe, ZfsWinGui and the ZfsWin PowerShell module."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                              ThirdFailureActionType="none" RestartServiceDelayInSeconds="10" ResetPeriodInDays="1" />
        </ServiceInstall>
        <!-- Least privilege, as in the kernel edition. -->
        <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\ZfsWinBroker" Name="RequiredPrivileges" Type="multiString">
          <MultiStringValue Value="SeChangeNotifyPrivilege" />
          <MultiStringValue Value="SeImpersonatePrivilege" />
          <MultiStringValue Value="SeCreateGlobalPrivilege" />
          <MultiStringValue Value="SeManageVolumePrivilege" />
          <MultiStringValue Value="SeBackupPrivilege" />
          <MultiStringValue Value="SeRestorePrivilege" />
        </RegistryValue>
        <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\ZfsWinBroker" Name="ServiceSidType" Type="integer" Value="1" />
        <ServiceControl Id="ZfsWinBrokerControl" Name="ZfsWinBroker" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <util:EventSource Name="ZfsWinBroker" Log="Application"
                          EventMessageFile="[WindowsFolder]Microsoft.NET\Framework\v4.0.30319\EventLogMessages.dll" />
      </Component>
      <Component Id="ZfsWinCli">
        <File Source="$(var.Payload)\bin\zfswin.exe" KeyPath="yes" />
      </Component>
      <Component Id="ZfsWinGui">
        <File Id="ZfsWinGui.exe" Source="$(var.Payload)\bin\ZfsWinGui.exe" KeyPath="yes" />
      </Component>
      <Component><File Source="$(var.Payload)\bin\zpool.exe" KeyPath="yes" /></Component>
      <Component><File Source="$(var.Payload)\bin\zfs.exe" KeyPath="yes" /></Component>
      <Component Id="SystemPath" Condition="ADDTOPATH = 1">
        <Environment Id="PathEntry" Name="PATH" Value="[BINFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\OpenZFS for Windows\UserMode" Name="AddedToPath" Value="1" Type="integer" KeyPath="yes" />
      </Component>
      <Component Id="VersionMetadata">
        <File Source="$(var.Payload)\VERSION.json" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\OpenZFS for Windows\UserMode" Name="Version" Value="$(var.Version)" Type="string" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\OpenZFS for Windows\UserMode" Name="InstallFolder" Value="[INSTALLFOLDER]" Type="string" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ReadMe" Directory="INSTALLFOLDER">
      <Component Id="ReadMe">
        <File Id="README.html" Source="$(var.Payload)\README.html" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Start menu: the administration tool (User mode tab) and the guide. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="OpenZFS for Windows (user mode)" />
    </StandardDirectory>
    <ComponentGroup Id="Shortcuts" Directory="ShortcutFolder">
      <Component Id="StartMenuShortcuts">
        <Shortcut Id="GuiShortcut" Name="OpenZFS for Windows (user mode)" Description="Mounts and the ZfsWinUserMode service"
                  Target="[#ZfsWinGui.exe]" WorkingDirectory="BINFOLDER" />
        <Shortcut Id="ReadMeShortcut" Name="OpenZFS for Windows (user mode) - Getting started" Target="[#README.html]" />
        <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\OpenZFS for Windows\UserMode" Name="StartMenuShortcuts" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Licenses" Directory="LICENSEFOLDER">
      <Files Include="$(var.Payload)\licenses\**" />
    </ComponentGroup>

    <ComponentGroup Id="Symbols" Directory="SYMBOLSFOLDER">
      <Files Include="$(var.Payload)\symbols\**" />
    </ComponentGroup>

    <ComponentGroup Id="PowerShellModule" Directory="PSMODULEFOLDER">
      <Files Include="$(var.Payload)\ZfsWin\**" />
    </ComponentGroup>

    <Feature Id="Main" Title="OpenZFS for Windows (user mode)" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="Service" />
      <ComponentGroupRef Id="PowerShellModule" />
      <ComponentGroupRef Id="Licenses" />
      <ComponentGroupRef Id="Symbols" />
      <ComponentGroupRef Id="ReadMe" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <!-- Getting started: after an interactive install or upgrade (not repair
         or uninstall), open README.html as the user.  From the client-side UI
         sequence, which runs only with a UI (double-click, /qr): in the
         server-side execute sequence UILevel is always 2 (step-16 VM run). -->
    <Property Id="WixShellExecTarget" Value="[#README.html]" />
    <CustomAction Id="OpenReadMe" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
                  Impersonate="yes" Return="ignore" />
    <InstallUISequence>
      <Custom Action="OpenReadMe" After="ExecuteAction" Condition="NOT Installed AND NOT REMOVE" />
    </InstallUISequence>
  </Package>
</Wix>
