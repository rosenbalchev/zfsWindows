<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>zfswin</AssemblyName>
    <RootNamespace>Zfs.Admin.Cli</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zfs.Admin\Zfs.Admin.csproj" />
    <InternalsVisibleTo Include="Zfs.Admin.Tests" />
  </ItemGroup>
  <Import Project="..\..\..\build\ZfsWinVersion.props" />
</Project>
