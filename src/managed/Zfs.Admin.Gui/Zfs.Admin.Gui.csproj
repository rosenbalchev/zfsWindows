<Project Sdk="Microsoft.NET.Sdk">
  <!-- ZfsWinGui.exe: the graphical administration tool (plan step 16).
       Framework-dependent: WinForms cannot be trimmed or AOT-compiled, and a
       self-contained copy would add about 60 MB to every package.  It needs
       the .NET 10 Desktop Runtime; the .NET launcher offers the download if
       it is missing.  It runs elevated (app.manifest) and talks to
       ZfsWinBroker like zfswin.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ZfsWinGui</AssemblyName>
    <RootNamespace>Zfs.Admin.Gui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>openzfs.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WebView2Loader.dll travels inside ZfsWinGui.exe; the installers ship that one file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The rid-specific apphost; the runtime itself is shared. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zfs.Admin\Zfs.Admin.csproj" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <!-- The tab content uses WebView2 when its runtime is installed; only the
         loader is bundled. Without it, native WinForms controls remain available. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>
  <!-- The package references its WPF control too; a WinForms app needs
       neither it nor the WindowsBase version conflict it brings. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
  <Import Project="..\..\..\build\ZfsWinVersion.props" />
</Project>
